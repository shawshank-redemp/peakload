<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.peakload</groupId>
  <artifactId>peakload</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>peakload</name>

  <properties>
    <java.version>21</java.version>
  </properties>

  <modules>
    <module>services/admission</module>
    <module>services/order</module>
    <module>services/dispatch</module>
    <module>services/tracking</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <!-- The build, the tests and the compiled code all target Java 21. A newer JDK on the PATH makes the
             test mocking library (Byte Buddy) fail, so the build refuses to run on anything but JDK 21.
             Run it with JAVA_HOME pointing at a JDK 21. The Dockerfile already uses JDK 21. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>require-jdk-21</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <message>This build needs JDK 21. Set JAVA_HOME to a JDK 21 (for example, Homebrew's
                    /opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home).</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
